# ImmortalWrt mainline custom profile: Ruijie RG-X60 New
# Fixed MTK U-Boot layout with UBI at 0x680000, size 0x6b00000 (107MiB).
# Single default profile: eBPF kernel integration, NETKIT, TProxy, TUN, FQ and BBR.
# This image embeds neither DAE, Honk, sing-box nor LuCI applications.
#
# NF_TPROXY_IPV4, NFT_TPROXY, NFT_SOCKET, NET_SCH_FQ, TCP_CONG_BBR and
# DEFAULT_TCP_CONG are not OpenWrt CONFIG_KERNEL_* symbols. They are applied to
# the target kernel config by the workflow and verified after the build.

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_mediatek_filogic_DEVICE_ruijie_rg-x60-new-mtkuboot=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_INCLUDE_CONFIG=y
# CONFIG_CCACHE is only selectable when DEVEL is enabled (config/Config-devel.in).
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# Diagnostic facilities.
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_FTRACE=y
CONFIG_KERNEL_FUNCTION_TRACER=y
CONFIG_KERNEL_DYNAMIC_FTRACE=y

# eBPF kernel integration (TC eBPF, DAE/KDAE and Honk paths).
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES is not set
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_NETKIT=y
CONFIG_KERNEL_PERF_EVENTS=y


# Mainline services and management.
# CONFIG_PACKAGE_apk-mbedtls is not set
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_base-files=y
# CONFIG_PACKAGE_bridger is not set
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_default-settings-chn=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_perf=y

# RG-X60-new hardware: mainline mt76 Wi-Fi and EN8811H WAN PHY.
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7986-firmware=y
CONFIG_PACKAGE_mt7986-wo-firmware=y
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_ethtool=y

# Native nftables/firewall4, including TProxy and socket matching.
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nft-socket=y

# Legacy iptables stays out; firewall4 is native nftables only.
# CONFIG_PACKAGE_ebtables is not set
# CONFIG_PACKAGE_ip6tables-nft is not set
# CONFIG_PACKAGE_ipset is not set
# CONFIG_PACKAGE_iptables-nft is not set
# CONFIG_PACKAGE_xtables-nft is not set
# CONFIG_PACKAGE_kmod-ebtables is not set
# CONFIG_PACKAGE_kmod-ebtables-ipv4 is not set
# CONFIG_PACKAGE_kmod-ebtables-ipv6 is not set
# CONFIG_PACKAGE_kmod-ip6tables is not set
# CONFIG_PACKAGE_kmod-ipt-compat-xtables is not set
# CONFIG_PACKAGE_kmod-ipt-core is not set
# CONFIG_PACKAGE_kmod-ipt-ipset is not set
# CONFIG_PACKAGE_kmod-ipt-tproxy is not set
# CONFIG_PACKAGE_kmod-iptables is not set
# CONFIG_PACKAGE_kmod-nf-ipt is not set
# CONFIG_PACKAGE_kmod-nf-ipt6 is not set
# CONFIG_PACKAGE_kmod-nft-compat is not set
# CONFIG_PACKAGE_libipset is not set
# CONFIG_PACKAGE_libiptext is not set
# CONFIG_PACKAGE_libiptext-nft is not set
# CONFIG_PACKAGE_libiptext6 is not set
# CONFIG_PACKAGE_libxtables is not set
# CONFIG_PACKAGE_iptables-mod-tproxy is not set

# eBPF runtime, TUN and virtual Ethernet support.
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# Deliberately exclude interactive monitors that you removed.
# CONFIG_PACKAGE_btop is not set
# CONFIG_PACKAGE_htop is not set
